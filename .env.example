# All optional. With none of these set the system runs in deterministic mode:
# retrieval, classification, the decision ledger, contradiction detection and
# every authorization control work with no network and no API key.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Model selection per vendor
# FA_ANTHROPIC_MODEL=claude-opus-5   # or claude-sonnet-5 for cheaper runs
# FA_OPENAI_MODEL=gpt-4.1

# Routing: which providers serve which task role, in order. "deterministic" is
# always appended as the floor even if you leave it out.
# FA_ROUTE_REASON=anthropic,openai,deterministic
# FA_ROUTE_RESEARCH=openai,anthropic,deterministic
# FA_ROUTE_REDTEAM=anthropic,deterministic

# Human-authorization credential for the approval console.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FA_APPROVER_TOKEN=dev-human-console-token

# Retrieval / safety thresholds
# FA_TOP_K=8
# FA_MIN_EVIDENCE=1.2
# FA_ACTION_TTL=900
